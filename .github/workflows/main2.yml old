 name: Scrape Upcoming Events

on:
  schedule:
    # প্রতি ৬ ঘণ্টা পর পর অটোমেটিকভাবে চলবে (UTC সময় অনুযায়ী)
    - cron: '0 */6 * * *'
  # ম্যানুয়ালি রান করার অপশন
  workflow_dispatch:

jobs:
  scrape-and-update:
    runs-on: ubuntu-latest

    permissions:
      contents: write # গিটহাবে ফাইল কমিট ও পুশ করার পারমিশন

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install Python Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install playwright

      - name: Install Playwright Browsers & System Dependencies
        run: |
          playwright install --with-deps chromium

      - name: Run Scraper Script
        run: |
          # স্ক্রিপ্টের ফাইল নাম অনুয়ায়ী পরিবর্তন করে নিন (যেমন: main.py)
          python main2.py

      - name: Commit and Push Changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          
          git add upcoming_events.json upcoming_events.html
          
          # যদি নতুন কোনো পরিবর্তন থাকে কেবল তখনই কমিট হবে
          if git diff --staged --quiet; then
            echo "No changes detected. Skipping commit."
          else
            git commit -m "chore: auto-update upcoming events data [skip ci]"
            git push
          fi
